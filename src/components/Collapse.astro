---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<details class="collapse collapse-arrow">
  <summary class="collapse-title text-2xl font-bold uppercase pl-0 md:pl-4 pt-4 md:pt-0">
    {title}
  </summary>
  <div class="collapse-content px-0 md:px-4">
    <slot />
  </div>
</details>
