---
import type { Experience } from '../../types/experience';
import { format } from 'date-fns';
import Collapse from '../Collapse.astro';
import ToolList from '../ToolList.astro';

interface Props {
  experience: Experience;
  isLastItem: boolean;
}

const { experience, isLastItem } = Astro.props;
const startLabel = format(new Date(experience.startDate), 'MMM yyyy');
const endLabel = experience.endDate
  ? format(new Date(experience.endDate), 'MMM yyyy')
  : 'Current';
---
<div>
  <div class="flex flex-col md:hidden w-full">
    <p class="text-xl font-bold uppercase">{experience.company}</p>
    <p class="text-neutral-950">{startLabel} - {endLabel}</p>
    <p class="font-bold uppercase">{experience.employmentType}</p>

    <Collapse title={experience.role}>
      <div>
        <ToolList class="mb-6" tools={experience.tools} />
        <div class="tiptap max-w-[80ch]" set:html={experience.content} />
      </div>
    </Collapse>
  </div>

  <div class="hidden md:flex gap-4 w-full">
    <div class="w-[40ch] text-right flex flex-col items-end">
      <p class="text-xl font-bold uppercase mt-0.5">{experience.company}</p>
      <p class="text-neutral-950">{startLabel} - {endLabel}</p>
      <p class="font-bold uppercase mb-6">{experience.employmentType}</p>
    </div>

    <div class="flex flex-col items-center w-4 translate-y-1.5">
      <div class="w-4 h-4 bg-sky-500 rounded-full ring-4 ring-sky-500/20 absolute"></div>
      {!isLastItem && <div class="h-full w-0.5 bg-sky-600"></div>}
    </div>

    <Collapse title={experience.role}>
      <div>
        <ToolList class="mb-6" tools={experience.tools} />
        <div class="tiptap max-w-[80ch]" set:html={experience.content} />
      </div>
    </Collapse>
  </div>
</div>
