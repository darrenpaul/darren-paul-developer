---
import type { Experience } from '../../types/experience';
import WorkExperienceListItem from './WorkExperienceListItem.astro';

interface Props {
  experiences: Experience[];
}

const { experiences } = Astro.props;
---
<div class="px-2 md:px-0">
  <h2 class="text-4xl font-bold mb-6 uppercase">Work Experience</h2>

  <div class="bg-white rounded-lg p-2 md:p-8 shadow-hard border-2 border-neutral-950 w-full">
    {experiences.map((experience, index) => (
      <WorkExperienceListItem experience={experience} isLastItem={index === experiences.length - 1} />
    ))}
  </div>
</div>
