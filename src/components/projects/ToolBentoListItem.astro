---
import { Image } from 'astro:assets';
import type { Tool } from '../../types/tool';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---
<div class="bg-white rounded-lg shadow-hard border-2 border-neutral-950 w-full aspect-square md:h-fit flex items-center justify-center">
  <Image
    src={tool.iconUri}
    alt={`${tool.title} Icon`}
    inferSize
    widths={[40, 80]}
    sizes="40px"
    format="avif"
    class="w-10"
  />
</div>
